# ReconAI Backend - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# API Configuration
API_VERSION=0.1.0
API_TITLE="ReconAI Backend"

# ============================================================================
# DATABASE
# ============================================================================

# SQLite Database Path
DB_PATH=./data/reconai.db

# Data Directory
DATA_DIR=./data

# Uploads Directory
UPLOADS_DIR=./data/uploads

# ============================================================================
# AUTHENTICATION (CLERK)
# ============================================================================

# Clerk Secret Key (from Clerk Dashboard)
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk Publishable Key (from Clerk Dashboard)
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk JWKS URL for JWT verification
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed origins (comma-separated)
# Leave empty to use defaults (localhost + production domains)
CORS_ORIGINS=

# Production frontend URLs (add your actual domains)
# CORS_ORIGINS=https://reconai.com,https://app.reconai.com

# ============================================================================
# FINANCIAL APIS
# ============================================================================

# Plaid Configuration (https://plaid.com)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox  # sandbox, development, or production

# ============================================================================
# AI & CLASSIFICATION
# ============================================================================

# Anthropic API Key (Claude AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude Model (claude-3-5-sonnet-20241022, etc.)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# EMAIL (Resend)
# ============================================================================

# Resend API Key (https://resend.com)
RESEND_API_KEY=re_UytakvdE_8TeYtsbxcNWhStzk3eTmiRYe

# From email address (must be verified in Resend)
RESEND_FROM_EMAIL=noreply@reconai.com

# From name
RESEND_FROM_NAME=ReconAI

# ============================================================================
# PAYMENT PROCESSING (STRIPE)
# ============================================================================

# Stripe API Keys (https://stripe.com)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_FREELANCER_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_FREELANCER_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_SMALL_BUSINESS_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_SMALL_BUSINESS_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_xxxxxxxxxxxx

# ============================================================================
# FEATURE FLAGS (Global Overrides)
# ============================================================================

# Enable/disable features globally (overrides tier settings)
FEATURE_DCAA_COMPLIANCE_ENABLED=true
FEATURE_MULTI_CURRENCY_ENABLED=true
FEATURE_WHITE_LABEL_ENABLED=true

# ============================================================================
# RATE LIMITING
# ============================================================================

# Redis URL for rate limiting (optional)
# If not set, uses in-memory rate limiting
REDIS_URL=redis://localhost:6379/0

# Rate limit multiplier (1.0 = normal, 2.0 = double limits)
RATE_LIMIT_MULTIPLIER=1.0

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
SENTRY_DSN=

# Sentry Environment
SENTRY_ENVIRONMENT=development

# ============================================================================
# STORAGE (File Uploads)
# ============================================================================

# Storage Backend (local, s3, gcs)
STORAGE_BACKEND=local

# AWS S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=reconai-uploads
AWS_S3_REGION=us-east-1

# Google Cloud Storage Configuration (if using GCS)
GCS_BUCKET=reconai-uploads
GCS_CREDENTIALS_PATH=./gcs-credentials.json

# Maximum upload size (in MB)
MAX_UPLOAD_SIZE_MB=25

# ============================================================================
# SECURITY
# ============================================================================

# Secret key for JWT signing (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production

# JWT Algorithm
JWT_ALGORITHM=HS256

# JWT Expiration (in seconds)
JWT_EXPIRATION_SECONDS=3600

# Password hashing rounds (bcrypt)
PASSWORD_HASH_ROUNDS=12

# ============================================================================
# CACHING
# ============================================================================

# Cache Backend (memory, redis)
CACHE_BACKEND=memory

# Cache TTL (in seconds)
CACHE_TTL=300

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug mode (NEVER in production!)
DEBUG=true

# Enable auto-reload on code changes
AUTO_RELOAD=true

# Enable SQL query logging
SQL_ECHO=false

# ============================================================================
# PRODUCTION SETTINGS
# ============================================================================

# Production domain
PRODUCTION_DOMAIN=api.reconai.com

# Enable HTTPS redirect
FORCE_HTTPS=false

# Trust proxy headers (X-Forwarded-For, etc.)
TRUST_PROXY=false

# Number of worker processes (for production)
WORKERS=4

# ============================================================================
# INDUSTRY TEMPLATES
# ============================================================================

# Enable specific industry templates
TEMPLATE_DCAA_ENABLED=true
TEMPLATE_VETERAN_ENABLED=true
TEMPLATE_LAW_ENFORCEMENT_ENABLED=true
TEMPLATE_HEALTHCARE_ENABLED=true

# ============================================================================
# VETERAN BENEFITS
# ============================================================================

# Veteran discount percentage (0.0 to 1.0)
VETERAN_DISCOUNT=0.50

# Automatic veteran verification (requires integration)
VETERAN_AUTO_VERIFY=false

# ============================================================================
# COMPLIANCE
# ============================================================================

# Enable DCAA audit trail
DCAA_AUDIT_TRAIL=true

# Enable HIPAA compliance features
HIPAA_ENABLED=false

# Data retention period (in years)
DATA_RETENTION_YEARS=7

# ============================================================================
# WEBHOOKS
# ============================================================================

# Webhook retry attempts
WEBHOOK_RETRY_ATTEMPTS=3

# Webhook timeout (in seconds)
WEBHOOK_TIMEOUT=30

# ============================================================================
# ANALYTICS (Optional)
# ============================================================================

# Google Analytics ID
GA_TRACKING_ID=

# Mixpanel Token
MIXPANEL_TOKEN=

# PostHog API Key
POSTHOG_API_KEY=

# ============================================================================
# SUPPORT
# ============================================================================

# Support email
SUPPORT_EMAIL=support@reconai.com

# Veterans priority support email
VETERAN_SUPPORT_EMAIL=veterans@reconai.com

# Status page URL
STATUS_PAGE_URL=https://status.reconai.com
